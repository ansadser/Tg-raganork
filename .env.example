BOT_TOKEN=123456:ABC...        # from @BotFather
OWNER_ID=123456789             # your Telegram user id (comma separated for more)
MODE=private                   # private = only owner uses fromMe commands, public = everyone
HANDLERS=./                    # command prefixes, "/" and "." both work
WARN_LIMIT=3
# BOT_API_ROOT=http://127.0.0.1:8081   # local Bot API server -> files up to 2GB
# YTDLP_COOKIES=./cookies.txt          # optional, helps for instagram
# PORT=3000                            # optional health endpoint for free hosts
